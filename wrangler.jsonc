{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sexologistbe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sexologistindia-db",
      "database_id": "38a7b174-df97-4f15-9d65-6ef04043e1c6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "sexologistindia" }],
  "vars": {
    "MEDIA_URL": "https://media.sexologistindia.com",
    "SITE_URL": "https://sexologistindia.com",
    "MIN_DOCTORS_PER_PAGE": "3",
    "CORS_ORIGINS": "http://localhost:5180,https://sexologistindia.com"
  }
  // Secrets (wrangler secret put ...): GOOGLE_PLACES_API_KEY, SESSION_SECRET
}
